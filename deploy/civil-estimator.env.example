# Copy to /etc/civil-estimator/civil-estimator.env and edit.
# Both the web app and the worker read this file, and they must agree on every
# path here — a queue the worker cannot see looks exactly like a queue nothing
# is processing.

# Where the app is installed and run from.
CIVIL_ESTIMATOR_HOME=/opt/civil-estimator

# Persistent data. Put these on the volume you back up.
CIVIL_ESTIMATOR_JOBS_DB=/var/lib/civil-estimator/jobs.db
CIVIL_ESTIMATOR_CACHE_DIR=/var/lib/civil-estimator/cache

# The password hash. Kept outside the checkout so a deploy never overwrites it
# and a container image never carries it. Create it with:
#   sudo -u estimator venv/bin/python bin/set_password.py
CIVIL_ESTIMATOR_SECRETS=/etc/civil-estimator/secrets.toml

# The local model host. Same machine by default.
OLLAMA_HOST=http://127.0.0.1:11434
CIVIL_ESTIMATOR_MODEL=qwen2.5vl:7b

# Streamlit. Bound to localhost because nginx terminates TLS in front of it;
# binding to 0.0.0.0 would publish the app on port 8501 with no certificate.
STREAMLIT_SERVER_ADDRESS=127.0.0.1
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
# Uploads are A0 drawings. The default 200 MB is generous; lower it if you like.
STREAMLIT_SERVER_MAX_UPLOAD_SIZE=200
